{
  "version": 2,
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "node build.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.js": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/api/:name(state|config)", "destination": "/api/gateway?route=/api/:name" },
    { "source": "/healthz", "destination": "/api/gateway?route=/healthz" },
    { "source": "/sub/:token", "destination": "/api/gateway?route=/sub/:token" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
