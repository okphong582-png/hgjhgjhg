{
  "version": 2,
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "mkdir -p dist && cp -r index.html media dist/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
