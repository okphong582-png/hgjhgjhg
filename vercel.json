{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/measure",
      "destination": "/measure.html"
    },
    {
      "source": "/api/:name",
      "destination": "/api/gateway?route=/api/:name"
    },
    {
      "source": "/sub/:token",
      "destination": "/api/gateway?route=/sub/:token"
    },
    {
      "source": "/key/:token/:feature",
      "destination": "/api/gateway?route=/key/:token/:feature"
    },
    {
      "source": "/:key/:feature",
      "destination": "/api/gateway?route=/:key/:feature"
    }
  ],
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
